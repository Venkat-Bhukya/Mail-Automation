import smtplib
import os
import pandas as pd
from datetime import datetime
from email.mime.text import MIMEText
from email.mime.multipart import MIMEMultipart
from email.mime.base import MIMEBase
from email import encoders
import schedule
import time

# Function to send email with multiple attachments
def send_email(to_email, subject, message, attachment_paths, smtp_server, smtp_port, sender_email, sender_password):
    try:
        # Set up the MIME
        msg = MIMEMultipart()
        msg['From'] = sender_email
        msg['To'] = to_email
        msg['Subject'] = subject
        
        # Attach the message
        msg.attach(MIMEText(message, 'plain'))
        
        # Attach each file
        for attachment_path in attachment_paths:
            if attachment_path and os.path.exists(attachment_path):
                with open(attachment_path, 'rb') as file:
                    mime = MIMEBase('application', 'octet-stream')
                    mime.set_payload(file.read())
                    encoders.encode_base64(mime)
                    mime.add_header(
                        'Content-Disposition', 
                        f'attachment; filename="{os.path.basename(attachment_path)}"'
                    )
                    msg.attach(mime)
            else:
                print(f"File not found: {attachment_path}")
        
        # Set up the server
        server = smtplib.SMTP(smtp_server, smtp_port)
        server.starttls()
        server.login(sender_email, sender_password)
        server.send_message(msg)
        server.quit()
        print(f"Email sent to {to_email}")
    except Exception as e:
        print(f"Failed to send email to {to_email}. Error: {e}")

# Function to check and send festival emails
def send_festival_emails():
    # Load data from Excel
    excel_file = 'data.xlsx'  # Change to your Excel file name
    names_emails = pd.read_excel(excel_file, sheet_name='Sheet1')  # Sheet1: Names and Emails
    festival_dates = pd.read_excel(excel_file, sheet_name='Sheet2')  # Sheet2: Dates, Festivals, and Image Paths

    # Email configuration
    SMTP_SERVER = 'smtp.gmail.com'  # Change based on your email provider
    SMTP_PORT = 587
    SENDER_EMAIL = 'venkatbhukya885@gmail.com'  # Replace with your email
    SENDER_PASSWORD = 'gmbptpeeijcdyryj'  # Replace with your email password

    # Check today's date
    today = datetime.now().strftime('%Y-%m-%d')

    # Filter festivals for today
    today_festivals = festival_dates[festival_dates['Date'] == today]

    # Send emails if there are festivals today
    if not today_festivals.empty:
        for _, festival_row in today_festivals.iterrows():
            festival_name = festival_row['Festival']
            attachments = str(festival_row['Attachments']).strip().split(',')  # Get list of attachments
            attachments = [attachment.strip() for attachment in attachments if attachment.strip()]  # Clean paths
            for _, contact_row in names_emails.iterrows():
                name = contact_row['Name']
                email = contact_row['Email']
                subject = f"Happy {festival_name}!"
                message = f"Dear {name},\n\nWishing you a joyful and wonderful {festival_name}!\n\nBest regards,\nData Pulse InfoTech and Team"
                send_email(email, subject, message, attachments, SMTP_SERVER, SMTP_PORT, SENDER_EMAIL, SENDER_PASSWORD)
    else:
        print("No festivals today.")

# Schedule the task
schedule.every().day.at("17:04:00").do(send_festival_emails)

print("Email scheduling started. Waiting...")
while True:
    schedule.run_pending()
    time.sleep(1)
